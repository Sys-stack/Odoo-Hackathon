# Copy this file to .env and fill in real values before deploying anywhere
# beyond your own machine. All of these have safe local-dev defaults if
# you skip this file entirely.

# Used to sign JWTs and Flask sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# SQLAlchemy connection string. Defaults to a local SQLite file.
# Postgres example: postgresql://user:password@localhost:5432/globetrotter
DATABASE_URL=sqlite:///waypoint.db

# Used by `python seed.py` to create (or promote) the admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Set to 1 to enable Flask's interactive debugger locally. Leave unset
# (or 0) anywhere the server might be reachable by anyone but you —
# the debugger allows remote code execution.
FLASK_DEBUG=0

# Required for the AI Trip Estimator screen (/estimate). Get a key at
# https://aistudio.google.com/apikey — the estimator returns a clear
# "not configured" error if this is left blank, it won't crash the app.
GEMINI_API_KEY=
# Override if gemini-2.0-flash is renamed/deprecated by the time you read this.
GEMINI_MODEL=gemini-2.0-flash
